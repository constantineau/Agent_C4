# /etc/c4-lab-backup.env — read by c4-lab-backup.service. See tools/backup/README.md.
# The NIGHTLY bucket, under its own prefix (lab_backup.py refuses a bucket root). Not the archive
# bucket: that one has a 1-year retention lock and versioning, so nothing could ever be pruned.
# Create it first (tools/backup/README.md "Enable it").
C4_BACKUP_DEST=gs://constantineau-c4-nightly/vps-nightly
# Staging on the data disk, never the root disk.
C4_BACKUP_WORK=/mnt/data/c4-backup/work
# Prune after every successful backup: the newest set of each of the last 7 days, 4 weeks,
# 12 months (Cole, 2026-11-02).
C4_BACKUP_PRUNE=1
C4_BACKUP_KEEP=7,4,12
# Defaults, listed so they are easy to change:
# C4_BACKUP_VOLUMES=sr33-dev_lab_ingested sr33-dev_lab_learning sr33-dev_lab_retro sr33-dev_lab_playbooks sr33-dev_lab_shares sr33-dev_lab_plume sr33-dev_lab_coastline sr33-dev_lab_enc
# C4_BACKUP_PG=sr33-dev-timescaledb-1:sr33:sr33_dev
PATH=/usr/local/bin:/usr/bin:/bin
HOME=/root
