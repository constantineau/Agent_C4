# /etc/c4-lab-backup.env — read by c4-lab-backup.service. See tools/backup/README.md.
# The NIGHTLY bucket, under its own prefix (lab_backup.py refuses a bucket root). Not the archive
# bucket: that one has a 1-year retention lock and versioning, so nothing could ever be pruned.
# Create it first (tools/backup/README.md "Enable it"). Fill in your bucket.
C4_BACKUP_DEST=gs://YOUR-NIGHTLY-BUCKET/vps-nightly
# The Agent_C4 checkout the service runs lab_backup.py from (absolute path). Fill in.
C4_REPO=/path/to/Agent_C4
# Staging on the data disk, never the root disk.
C4_BACKUP_WORK=/mnt/data/c4-backup/work
# Prune after every successful backup: the newest set of each of the last 7 days, 4 weeks,
# 12 months (Cole, 2026-11-02).
C4_BACKUP_PRUNE=1
C4_BACKUP_KEEP=7,4,12
# Defaults, listed so they are easy to change:
# C4_BACKUP_PROJECT=<the dev compose project>   (names the volumes <project>_lab_* and the db container;
#   default: C4_DEV_PROJECT from the .env of the checkout lab_backup.py runs from, else c4-dev, #314)
# C4_BACKUP_VOLUMES=<project>_lab_ingested <project>_lab_learning ... (see lab_backup.py)
# C4_BACKUP_PG=<project>-timescaledb-1:<user>:<db>
PATH=/usr/local/bin:/usr/bin:/bin
HOME=/root
