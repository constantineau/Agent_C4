# Copy to .env and fill in. .env is gitignored.

# --- Stack names (#314) ---
# Compose project, database and volume names. A NEW install leaves these unset and gets the neutral
# defaults: projects c4-dev / c4-prod / c4-boat / c4-bench, database c4_dev (prod: c4_prod), user c4,
# database volumes c4-dev_pgdata / c4-prod_pgdata.
# An EXISTING install pins the names it already runs under, BEFORE pulling the change that brought
# these defaults, so a rebuild finds the same containers, volumes and database (nothing is renamed).
# Read the live names off the box: `docker ps` (containers <project>-<service>-1), `docker volume ls`.
# Then check: `docker compose -f compose.dev.yml config` shows the same `name:` and volume names.
# Each compose file reads its own variable (not COMPOSE_PROJECT_NAME): dev and prod share this file.
# Example pins for a box set up before the change (the pre-#314 names):
#C4_DEV_PROJECT=sr33-dev
#C4_DEV_PGDATA=sr33-dev_sr33_dev_pgdata
#C4_PROD_PROJECT=sr33-prod
#C4_PROD_PGDATA=sr33-prod_sr33_prod_pgdata
#C4_BOAT_PROJECT=sr33-pi          # on the boat's Pi (compose.pi.yml)
#C4_BENCH_PROJECT=sr33-pi         # on a bench host (compose.pi.sample.yml), to keep its old volumes
# ...plus POSTGRES_USER / POSTGRES_DB below set to the existing user and database.

# --- TimescaleDB ---
POSTGRES_USER=c4
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=c4_dev
# DSN used by the services (host is the compose service name "timescaledb")
DATABASE_URL=postgresql://c4:CHANGE_ME@timescaledb:5432/c4_dev

# --- Ingestion auth ---
# Bearer token the Pi uplink uses to POST telemetry batches.
INGEST_TOKEN=dev-ingest-token

# --- Agent ---
# Anthropic API key for the agent's tool-use loop (Phase 4). Leave blank in Phase 0:
# the agent falls back to a deterministic, tool-grounded reply with no LLM call.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Playbook synthesis + routing briefing try these in order (Fable primary, Opus fallback):
ANTHROPIC_MODEL_CHAIN=claude-fable-5-1,claude-opus-5
# Lab race import (NOR/SI extraction) only — every other Lab AI call uses the chain above:
ANTHROPIC_IMPORT_MODEL_CHAIN=claude-opus-5-5,claude-fable-5-1

# --- Web app auth (Phase 7) ---
# Single shared boat password for the crew web interface (POST /auth exchanges it for a
# signed bearer token used on REST + the WebSocket). Required, no default: the agent will not
# start without it (unless AUTH_ENABLED=false). Pick your own; never reuse an example value.
BOAT_PASSWORD=
# HMAC secret that signs session tokens. Defaults to a value derived from BOAT_PASSWORD;
# set a fresh random value in prod (e.g. `openssl rand -hex 32`).
AUTH_SECRET=
# Session lifetime in hours (default 720 = 30 days, so the crew don't re-auth mid-passage).
AUTH_TTL_HOURS=720
# Set false to disable the check entirely (open bench only — never in prod).
AUTH_ENABLED=true

# --- TLS / domain (Phase 7, prod only) ---
# Public domain for the crew web app (the TLS cert CN). DNS A record must point at the VPS.
SERVER_NAME=nav.example.com
# Email for the Let's Encrypt account (expiry notices). Used by deploy/init_tls.sh.
CERTBOT_EMAIL=you@example.com
# Web nginx serves HTTPS once a cert exists; leave true for prod. (Dev web ignores this.)
TLS_ENABLED=true

# --- Boat identity ---
# Required, no default: every service that labels or reads boat data refuses to start without it,
# so one boat's data is never filed under another's name. Use the boat's profile id
# (vps/lab/boats/<id>.json).
BOAT_ID=
# The boat the Lab's Deploy push carries the re-route chart + profile for when the locked
# playbook doesn't say. Required by the dev compose; usually the same as BOAT_ID.
DEPLOY_BOAT_ID=

# --- C4 Performance Lab (dev compose service `lab`, :8103) ---
# Shared team login for the Lab browser app (compose default: lab-dev; the standing
# lab.racertracer.net container uses its own value).
LAB_PASSWORD=lab-dev
# Set false to disable the Lab gate (open bench only).
LAB_AUTH_ENABLED=true
# Optional: separate HMAC secret + TTL for Lab session tokens (default derived from LAB_PASSWORD).
LAB_AUTH_SECRET=
LAB_AUTH_TTL_HOURS=720
# Feedback widget -> GitHub issues (💬 button on the Lab + crew dashboard).
GITHUB_TOKEN=
GITHUB_REPO=constantineau/Agent_C4
FEEDBACK_ALLOW_ORIGINS=https://c4.racertracer.net,https://lab.racertracer.net,http://localhost:8091
# Obstacle sources: COASTLINE_SOURCE=enc|global, COASTLINE_GLOBAL=gshhg|natural_earth, GSHHG_RES=f..c
#COASTLINE_SOURCE=enc
# Race mode default for the cloud gate (dev compose sets practice; prod omits -> fail-closed race).
#RACE_MODE_DEFAULT=practice

# --- Lab "Lock-in & Deploy" push-to-boat (vps/lab/app/deploy.py; all optional) ---
# The Pi the Lab's manual-load commands ssh to. A playbook always goes to the Pi engine's
# /playbook/load (the Pi passes it to the Orin copilot and approves it); never copy it to the Orin.
# No address or host name has a default in code (#314): set these for your boat.
# The boat's Pi engine over Tailscale. Unset: Deploy, the live boat read and the plume push say so
# and send nothing.
DEPLOY_PI_ENGINE_URL=
# The Orin copilot through the Pi console's proxy (default: the engine's host :8091/copilot).
#DEPLOY_COPILOT_URL=http://<pi-tailnet-ip>:8091/copilot
# ssh target shown in the manual-load commands, and the engine as seen from the Pi.
#DEPLOY_PI_HOST=<user>@<pi-host>
#DEPLOY_PI_ENGINE=http://127.0.0.1:8200
# This host's Tailscale address: compose.dev.yml publishes ingestion/agent/web/lab on it so the boat
# can reach them. Required by compose.dev.yml.
VPS_TAILNET_IP=
# Bench only (compose.pi.sample.yml): the Orin's copilot over Tailscale, http://<orin-tailnet-ip>:8300
#BENCH_ORIN_URL=

# --- Onboard copilot extras (Orin service env, documented here for reference) ---
# Engine address failover (boat-local first). The fallback is used only if it is on the boat
# (10.10.10.0/24 cable or loopback); a Tailscale fallback also needs ENGINE_FALLBACK_OFFBOAT=1,
# shore-side dev only, never on the boat (#53):
#ENGINE_URL_FALLBACK=http://<pi-tailnet-ip>:8200
#ENGINE_FALLBACK_OFFBOAT=1
# Label stamped into signed playbooks at freeze:
#PLAYBOOK_SIGNED_BY=
